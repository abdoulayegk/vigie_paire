# Copier ce fichier vers .env et renseigner les valeurs réelles.
# Ne jamais commiter le fichier .env (déjà dans .gitignore).

# ---------------------------------------------------------------
# Requis
# ---------------------------------------------------------------

# Clé API OpenAI — obtenir sur https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------
# Optionnel — Provider LLM (OpenAI public par défaut)
# ---------------------------------------------------------------

# LLM_PROVIDER=openai
# OPENAI_MODEL_CHAT=gpt-5.4
# LLM_REASONING_EXTRACTION=high
# LLM_REASONING_DEFAULT=medium
# LLM_REASONING_LOCATOR=low

# Azure OpenAI (opt-in entreprise) :
# LLM_PROVIDER=azure
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT_CHAT=<nom-deploiement-gpt54>
# AZURE_OPENAI_DEPLOYMENT_EMBEDDING_SMALL=<nom-deploiement-embed-small>
# AZURE_OPENAI_DEPLOYMENT_EMBEDDING_LARGE=<nom-deploiement-embed-large>

# ---------------------------------------------------------------
# Optionnel — Interface Dash
# ---------------------------------------------------------------

# Port d'écoute de l'application Dash (défaut : 8050)
DASH_PORT=8050

# Mode debug Dash — 1 = activé, 0 = désactivé (défaut : 0)
DASH_DEBUG=0

# ---------------------------------------------------------------
# Optionnel — Performance
# ---------------------------------------------------------------

# Nombre de threads pour Docling (extraction PDF, défaut : 4)
DOCLING_NUM_THREADS=4

# Activer l'OCR Docling pour l'extraction narrative (défaut : désactivé)
# VIGIE_TEXT_OCR_ENABLED=1

# Désactiver explicitement l'extraction Vision (défaut du projet : activé)
# VIGIE_VISION_EXTRACTION_ENABLED=0

# Activer le dump des images de crop pour débogage (1 = activé)
ENABLE_TABLE_CROP_DUMP=0
