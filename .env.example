# Copier ce fichier vers .env et renseigner les valeurs réelles.
# Ne jamais commiter le fichier .env (déjà dans .gitignore).

# ---------------------------------------------------------------
# Requis
# ---------------------------------------------------------------

# Clé API OpenAI — obtenir sur https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------
# Optionnel — Interface Dash
# ---------------------------------------------------------------

# Port d'écoute de l'application Dash (défaut : 8050)
DASH_PORT=8050

# Mode debug Dash — 1 = activé, 0 = désactivé (défaut : 0)
DASH_DEBUG=0

# ---------------------------------------------------------------
# Optionnel — Performance
# ---------------------------------------------------------------

# Nombre de threads pour Docling (extraction PDF, défaut : 4)
DOCLING_NUM_THREADS=4

# Activer l'OCR Docling pour l'extraction narrative (1 = activé)
VIGIE_TEXT_OCR_ENABLED=0

# Activer l'extraction Vision en l'absence de surcharge explicite (1 = activé)
VIGIE_VISION_EXTRACTION_ENABLED=0

# Activer le dump des images de crop pour débogage (1 = activé)
ENABLE_TABLE_CROP_DUMP=0
